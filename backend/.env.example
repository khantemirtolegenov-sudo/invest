# Строка подключения к PostgreSQL (создайте пустую базу — таблицы сервер сделает сам миграциями)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hub_dev
# Секрет подписи токенов входа. В production ОБЯЗАТЕЛЕН свой длинный случайный
JWT_SECRET=dev-only-change-me
PORT=5185
# Адреса, с которых открывают портал (через запятую)
CORS_ORIGIN=http://localhost:5184

# Первый администратор (npm run db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Администратор

# @module:telegram:start
# Telegram-уведомления: бот от @BotFather. Пусто — модуль выключен, портал работает
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# @module:telegram:end
